generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum RefType {
  PURCHASE
  SALE
  MANUAL
}

enum NotificationType {
  LOW_STOCK
  INFO
}

enum TransactionStatus {
  POSTED
  VOIDED
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role                 @default(EMPLOYEE)
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  purchases           Purchase[]
  voidedPurchases     Purchase[]           @relation("PurchaseVoidedBy")
  sales               Sale[]
  voidedSales         Sale[]               @relation("SaleVoidedBy")
  stockMovements      StockMovement[]
  notifications       Notification[]
  emailChangeRequests EmailChangeRequest[]

  @@map("users")
}

model Category {
  id                 String             @id @default(cuid())
  name               String
  isActive           Boolean            @default(true) @map("is_active")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  products           Product[]
  supplierCategories SupplierCategory[]

  @@index([isActive])
  @@map("categories")
}

model Supplier {
  id                 String             @id @default(cuid())
  name               String
  phone              String?
  address            String?
  isActive           Boolean            @default(true) @map("is_active")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  purchases          Purchase[]
  supplierCategories SupplierCategory[]

  @@index([isActive])
  @@map("suppliers")
}

model SupplierCategory {
  supplierId String   @map("supplier_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([supplierId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model Product {
  id                    String                 @id @default(cuid())
  categoryId            String                 @map("category_id")
  name                  String
  sku                   String                 @unique
  unit                  String
  stock                 Int                    @default(0)
  minStock              Int                    @default(0) @map("min_stock")
  buyPrice              Decimal                @map("buy_price") @db.Decimal(14, 2)
  sellPrice             Decimal                @map("sell_price") @db.Decimal(14, 2)
  isActive              Boolean                @default(true) @map("is_active")
  deletedAt             DateTime?              @map("deleted_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  category              Category               @relation(fields: [categoryId], references: [id])
  purchaseItems         PurchaseItem[]
  saleItems             SaleItem[]
  stockMovements        StockMovement[]
  emailNotificationLogs EmailNotificationLog[]

  @@index([categoryId])
  @@index([stock])
  @@index([isActive])
  @@map("products")
}

model Purchase {
  id          String            @id @default(cuid())
  supplierId  String            @map("supplier_id")
  date        DateTime
  totalAmount Decimal           @map("total_amount") @db.Decimal(14, 2)
  status      TransactionStatus @default(POSTED)
  createdBy   String            @map("created_by")
  voidedBy    String?           @map("voided_by")
  voidedAt    DateTime?         @map("voided_at")
  voidReason  String?           @map("void_reason")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  creator     User              @relation(fields: [createdBy], references: [id])
  voider      User?             @relation("PurchaseVoidedBy", fields: [voidedBy], references: [id])
  items       PurchaseItem[]

  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String   @map("purchase_id")
  productId  String   @map("product_id")
  qty        Int
  buyPrice   Decimal  @map("buy_price") @db.Decimal(14, 2)
  subtotal   Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId, productId])
  @@map("purchase_items")
}

model Sale {
  id          String            @id @default(cuid())
  date        DateTime
  totalAmount Decimal           @map("total_amount") @db.Decimal(14, 2)
  status      TransactionStatus @default(POSTED)
  createdBy   String            @map("created_by")
  voidedBy    String?           @map("voided_by")
  voidedAt    DateTime?         @map("voided_at")
  voidReason  String?           @map("void_reason")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  creator     User              @relation(fields: [createdBy], references: [id])
  voider      User?             @relation("SaleVoidedBy", fields: [voidedBy], references: [id])
  items       SaleItem[]

  @@index([date])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  productId String   @map("product_id")
  qty       Int
  sellPrice Decimal  @map("sell_price") @db.Decimal(14, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId, productId])
  @@map("sale_items")
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String            @map("product_id")
  type        StockMovementType
  qty         Int
  beforeStock Int               @map("before_stock")
  afterStock  Int               @map("after_stock")
  refType     RefType           @map("ref_type")
  refId       String            @map("ref_id")
  actorId     String            @map("actor_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  product     Product           @relation(fields: [productId], references: [id])
  actor       User              @relation(fields: [actorId], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  userId    String           @map("user_id")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model EmailNotificationLog {
  id           String    @id @default(cuid())
  productId    String    @map("product_id")
  recipient    String
  status       String
  providerRef  String?   @map("provider_ref")
  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  product      Product   @relation(fields: [productId], references: [id])

  @@map("email_notification_logs")
}

model EmailChangeRequest {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  currentEmail            String    @map("current_email")
  newEmail                String    @map("new_email")
  currentEmailTokenHash   String    @unique @map("current_email_token_hash")
  newEmailTokenHash       String    @unique @map("new_email_token_hash")
  currentEmailConfirmedAt DateTime? @map("current_email_confirmed_at")
  newEmailConfirmedAt     DateTime? @map("new_email_confirmed_at")
  expiresAt               DateTime  @map("expires_at")
  completedAt             DateTime? @map("completed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_change_requests")
}
